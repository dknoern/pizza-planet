# MongoDB connection string used by Prisma.
#
# IMPORTANT: Prisma's MongoDB connector uses transactions internally (even for
# simple operations like deleteMany), so the server MUST be a replica set —
# a standalone mongod will fail with P2031. For local dev, run a single-node
# replica set in Docker (see README) and use the directConnection form below.
#
# Local single-node replica set:
#   mongodb://localhost:27017/pizza-planet?directConnection=true&replicaSet=rs0
# Mongo Atlas:
#   mongodb+srv://<user>:<pass>@<cluster>/pizza-planet?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/pizza-planet?directConnection=true&replicaSet=rs0"

# 32+ random bytes used to sign the session cookie (iron-session).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-32-plus-random-chars-or-the-app-will-refuse-to-boot"

# Selects the payment processor implementation. v1 only supports "simulator".
PAYMENT_SIM_MODE="simulator"

# Secret used to sign guest-order lookup tokens (JWT, 7-day expiry).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUEST_TOKEN_SECRET="change-me-too-32-plus-random-chars"

# Node environment (development | test | production)
NODE_ENV="development"

# --- Login with Amazon (LWA) ---
# Leave these unset to disable LWA — the routes will return 503 and the UI
# button is hidden. Set all four to enable.
#
# Client ID from the LWA Security Profile (Amazon Developer console).
LWA_CLIENT_ID=""
# Client secret from the LWA Security Profile. NEVER expose to the browser.
LWA_CLIENT_SECRET=""
# Exact-match redirect URI registered as an Allowed Return URL on the Security
# Profile. Must be HTTPS. For local dev use an HTTPS tunnel (e.g. ngrok).
LWA_REDIRECT_URI=""
# 32+ random bytes used to sign the short-lived pp_lwa scratchpad cookie that
# carries the OAuth state + PKCE verifier across the Amazon redirect.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LWA_COOKIE_SECRET=""
